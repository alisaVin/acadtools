<Window x:Class="ACADTools.Views.InfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ACADTools.Views"
        mc:Ignorable="d"
        Title="Information"
        FontFamily="Segoe UI"
        Width="450" Height="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid x:Name ="InfoLayout" Margin="10,15" Width="350" Height="180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="40" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"
               FontSize="16" FontWeight="DemiBold">ACADTools Version 1.0.0.1</Label>
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"
               FontSize="12">für AutoCAD 2021-2024 (64 bit)</Label>
        <Image x:Name="kresLogo" Grid.Row="3" Source="/ACADTools;component/Resources/CD-Logo_freigestellt.png"/>
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5"
               FontSize="10">Keßler Real Estate Solutions GmbH</Label>
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="6"
               FontSize="10">Copyright © 2025</Label>
    </Grid>
</Window>
